# Copy to .env (git-ignored) and fill in your values: cp .env.example .env

# --- Search (required) ---
TAVILY_API_KEY=

# --- LLM provider: "anthropic" or "openai" (openai = any OpenAI-compatible API) ---
# Optional: if empty, it is inferred (openai when only OPENAI_* are set, otherwise anthropic).
LLM_PROVIDER=openai

# OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
